+package app
+
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.asPaddingValues
+import androidx.compose.foundation.layout.statusBars
+import androidx.compose.runtime.Composable
+
+/**
+ * The Android entry point. The activity draws edge to edge, so the status bar overlaps the top of
+ * the window; its height is handed to [App] as the inset the nav strip and page headers clear.
+ * (The bottom inset is handled inside the lists themselves.)
+ */
+@Composable
+fun AndroidApp() {
+    App(topInset = WindowInsets.statusBars.asPaddingValues().calculateTopPadding())
+}
